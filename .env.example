# Supabase の Project Settings → API からコピーする
# anon key はブラウザに出るので公開前提のもの。service_role key は絶対に置かない。
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# 開発用の SQL 実行（scripts/sql.mjs）でだけ使う。アプリは読まない。
# ★ VITE_ を付けないこと。付けるとバンドルに焼き込まれて公開される。
# ★ これは RLS を全部素通りする鍵。Settings → Database で再設定できる。
SUPABASE_DB_PASSWORD=
