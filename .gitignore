# 依存
node_modules/

# ビルド成果物
dist/
build/
.vite/

# 環境変数（Supabase の URL / anon key / service role key）
.env
.env.*
!.env.example

# Supabase CLI
supabase/.branches/
supabase/.temp/
supabase/config.toml

# 自動生成した型定義（src/types/database.ts）は、生成物だが git に含める。
# 含めないとクローンしただけでは型チェックが通らず、生成には Supabase の
# 認証情報が要るため。手書きはせず、スキーマ変更後は npm run gen:types で作り直す。

# エディタ・OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# ログ
*.log
npm-debug.log*

# ビルド成果物（テスト用）
dist-test/
*.tsbuildinfo
